rules_version = '2';

// haru-recruit Firestore 보안 규칙
//
// 원칙: **클라이언트는 필요한 최소한만 한다.** 이 사이트는 지원자용이다 — 공고를 보고 지원서를
// 낸다. 목록을 읽는 화면은 더 이상 없다(관리자 포털 폐지, 2026-09-24). 지원서 열람·심사는
// StayOps 가 서비스 계정으로 한다. 서비스 계정은 IAM 인증이라 이 규칙을 우회하므로,
// 여기서 읽기를 막아도 StayOps 동기화는 그대로 동작한다.
//
// 이 프로젝트는 몇 달간 지원자 개인정보가 인증 없이 열려 있었다(2026-09-11 확인·차단).
// 원인은 어드민이 Firebase Auth 를 쓰지 않아, 그 화면이 동작하려면 공개 읽기가 필요했던 것이다.
// 그 화면이 사라졌으므로 읽기를 열어 둘 이유가 남아 있지 않다.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 지원서 ────────────────────────────────────────────────────────────
    // 지원 폼이 쓴다. 읽기·수정·삭제는 전면 차단 — 이름·전화·주소·비자·이력서 링크가 담긴다.
    match /applications/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // 구 지원 폼의 레거시 컬렉션. 이제 아무도 쓰지 않는다.
    match /applicants/{docId} {
      allow read, write: if false;
    }

    // ── 실시간 상담 — 폐지됨 (2026-09-24) ────────────────────────────────
    // 화면을 없앴어도 컬렉션은 남는다. 이름·전화번호가 들어 있으므로 함께 닫는다.
    // 기존 3건은 폐지 전에 내보냈다.
    match /chat_rooms/{roomId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ── 방문자 카운터 ─────────────────────────────────────────────────────
    // 랜딩 페이지가 `siteStats/visitors_YYYY-MM-DD` 문서의 count 를 +1 한다.
    // 담기는 것은 날짜별 집계 숫자뿐이라 읽기는 공개로 둔다(개인정보 없음).
    //
    // **쓰기는 「+1」만 허용한다.** 그냥 열어 두면 누구나 카운터를 임의의 수로 덮어쓸 수 있다
    // (2026-09-11 잠금 전이 그 상태였다). 규칙으로 모양을 강제하면 화면은 그대로 동작하면서
    // 장난은 막힌다 — 한 번에 1씩만, 필드는 count/date 둘뿐, 날짜는 못 바꾸고, 삭제는 불가.
    //
    // 문서 id 도 `visitors_YYYY-MM-DD` 형태로 묶어 쓰레기 문서가 쌓이지 않게 한다.
    match /siteStats/{docId} {
      allow read: if true;

      allow create: if docId.matches('^visitors_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.keys().hasOnly(['count', 'date'])
                    && request.resource.data.count == 1
                    && request.resource.data.date is string;

      allow update: if docId.matches('^visitors_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.keys().hasOnly(['count', 'date'])
                    && request.resource.data.date == resource.data.date
                    && request.resource.data.count == resource.data.count + 1;

      allow delete: if false;
    }

    // ── 그 밖의 모든 것 ───────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
